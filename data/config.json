{
  "ignoreDirectories": [
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    "bower_components",
    "vendor",
    "dist",
    "build",
    "out",
    "target",
    "bin",
    "obj",
    ".next",
    ".nuxt",
    ".turbo",
    ".cache",
    ".venv",
    "venv",
    "env",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".tox",
    "coverage",
    ".nyc_output",
    ".idea",
    ".vs"
  ],
  "ignoreExtensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".ico",
    ".svg",
    ".webp",
    ".mp4",
    ".mp3",
    ".wav",
    ".ogg",
    ".mov",
    ".avi",
    ".pdf",
    ".zip",
    ".tar",
    ".gz",
    ".7z",
    ".rar",
    ".exe",
    ".dll",
    ".so",
    ".dylib",
    ".bin",
    ".pyc",
    ".pyo",
    ".class",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot",
    ".otf",
    ".map",
    ".lock"
  ],
  "maxFileSizeBytes": 1048576,
  "alignedThreshold": 0.62,
  "driftingThreshold": 0.38,
  "minLogicShare": 18,
  "entrypointFiles": [
    "main.py", "app.py", "run.py", "server.py", "cli.py",
    "__main__.py", "manage.py", "index.js", "index.ts",
    "index.jsx", "index.tsx", "program.cs", "main.go"
  ]
}
